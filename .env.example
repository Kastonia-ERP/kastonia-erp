NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
SUPABASE_JWT_SECRET=your-jwt-secret-server-only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_BUCKET=kastonia-files
SUPABASE_STORAGE_BUCKET=kastonia-files
NEXT_PUBLIC_APP_ENV=development

# v1.9.1 mobile documents and accounting handoff
NEXT_PUBLIC_MAX_UPLOAD_MB=15
NEXT_PUBLIC_ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,image/heic,image/heif,image/webp
ACCOUNTING_EXPORT_PROVIDER=generic-package
